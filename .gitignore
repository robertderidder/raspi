# ---------------------------------------------------------------------------
# Secrets. See the "Secrets" section in README.md.
# These rules exist so a stray `git add -A` cannot pull them in.
# ---------------------------------------------------------------------------

# Telegram bot credentials (BOT_TOKEN, ALLOWED_CHAT_ID)
.env
tokens.py

# Who the bot has granted access to, written by /access at runtime. Chat ids
# are not credentials, but a leaked token plus a known id is a way in -- and
# the roommate's id is not ours to publish either way.
telegram-bot/allowed_chats.json

# A raw Teleporter archive still contains the unscrubbed pihole.toml. The backup
# script unpacks and scrubs into pihole-backup/ and never leaves a .zip behind,
# so one appearing here is a stray from a manual export -- keep it out.
pihole-backup/*.zip
*teleporter*.zip

# copyparty: password/filekey hashing salts and live login sessions.
# Anyone with the salts can attack the account hashes offline; anyone with
# sessions.db can resume a logged-in session. copyparty.conf itself is fine
# to track as long as no `pw:` lines are added to it.
.config/copyparty/*-salt.txt
.config/copyparty/iphash
.config/copyparty/sessions.db*

# transmission: settings.json holds the salted rpc-password hash, and the
# daemon rewrites the whole file on shutdown -- so it cannot be scrubbed in
# place. Track settings.example.json instead.
.config/transmission-daemon/settings.json
.config/transmission-daemon/settingsold.json
.config/transmission-daemon/stats.json
.config/transmission-daemon/dht.dat
.config/transmission-daemon/*.bak-*

# tinytuya: tinytuya.json holds the Tuya cloud apiKey/apiSecret, and the
# device dumps hold each device's local_key -- enough to control the devices
# on the LAN. Re-create them with `tinytuya wizard`.
tuya/tinytuya.json
tuya/devices.json
tuya/tuya-raw.json
tuya/snapshot.json

# Keys and certificates of any kind
*.key
*.pem
*.crt
id_*
!id_*.pub
authorized_keys
known_hosts*

# ---------------------------------------------------------------------------
# Churn -- rebuildable, or machine state that changes every boot
# ---------------------------------------------------------------------------
venv/
.venv/
__pycache__/
*.pyc
*.log
.bash_history
.zsh_history
.lesshst
.viminfo
